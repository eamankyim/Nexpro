# Local ABS API origin for Next.js /api rewrites (no trailing slash)
ABS_API_ORIGIN=http://127.0.0.1:5002

# Optional: call ABS directly from the browser (triggers CORS). Prefer leaving unset
# so the app uses same-origin /api via the rewrite above.
# NEXT_PUBLIC_ABS_API_URL=http://127.0.0.1:5002/api
